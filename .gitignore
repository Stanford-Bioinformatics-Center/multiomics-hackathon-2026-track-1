# Keep data and figures out of the repository: the pipeline writes them to $HACK_OUT / $HACK_RES / $HACK_FIG
# (outside the repo). Only code and documentation are committed.
*.csv
*.tsv
*.parquet
*.rds
*.png
*.pdf
*.svg
.DS_Store

# interaction_db: curation tables are code, not data
!network/interaction_db/curation/*.csv

# documentation figures shown in the READMEs (small, regenerated by network/docs/make_*.R)
!network/docs/figures/*.png

# music video renderer: installed Node packages (npm install in network/video/render)
network/video/render/node_modules/
__pycache__/
